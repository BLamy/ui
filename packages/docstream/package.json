      "source": "./src/openapi/OpenApiOperation.tsx",
      "types": "./dist/openapi/OpenApiOperation.d.ts",
      "import": "./dist/openapi/OpenApiOperation.js",
      "default": "./dist/openapi/OpenApiOperation.js"
    },
    "./replay": {
      "@org/source": "./src/replay/index.ts",
      "source": "./src/replay/index.ts",
      "types": "./dist/replay/index.d.ts",
      "import": "./dist/replay/index.js",
      "default": "./dist/replay/index.js"
    },
    "./replay/demo": {
      "@org/source": "./src/replay/demo/index.ts",
      "source": "./src/replay/demo/index.ts",
      "types": "./dist/replay/demo/index.d.ts",
      "import": "./dist/replay/demo/index.js",
      "default": "./dist/replay/demo/index.js"
    },
    "./video": {
