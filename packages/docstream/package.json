      "import": "./dist/stl/index.js",
      "default": "./dist/stl/index.js"
    },
    "./strudel": {
      "@org/source": "./src/strudel/index.ts",
      "source": "./src/strudel/index.ts",
      "types": "./dist/strudel/index.d.ts",
      "import": "./dist/strudel/index.js",
      "default": "./dist/strudel/index.js"
    },
    "./viz": {
      "@org/source": "./src/viz/index.ts",
      "source": "./src/viz/index.ts",
      "types": "./dist/viz/index.d.ts",
      "import": "./dist/viz/index.js",
