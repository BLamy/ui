{
  "name": "@brett_lamy/docstream",
  "version": "1.19.1",
  "description": "GitBook-aware readonly markdown and AI stream renderer.",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -b tsconfig.json",
    "test": "vitest run",
    "prepack": "npm run build"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "!src/**/__fixtures__",
    "README.md"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "@org/source": "./src/index.ts",
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./gitbook": {
      "@org/source": "./src/gitbook/index.ts",
      "source": "./src/gitbook/index.ts",
      "types": "./dist/gitbook/index.d.ts",
      "import": "./dist/gitbook/index.js",
      "default": "./dist/gitbook/index.js"
    },
    "./properties": {
      "@org/source": "./src/docs/DocumentProperties.tsx",
      "source": "./src/docs/DocumentProperties.tsx",
      "types": "./dist/docs/DocumentProperties.d.ts",
      "import": "./dist/docs/DocumentProperties.js",
      "default": "./dist/docs/DocumentProperties.js"
    },
    "./properties/styles.css": {
      "@org/source": "./src/docs/properties.css",
      "default": "./dist/docs/properties.css"
    },
    "./tasks": {
      "@org/source": "./src/docs/TaskCheckbox.tsx",
      "source": "./src/docs/TaskCheckbox.tsx",
      "types": "./dist/docs/TaskCheckbox.d.ts",
      "import": "./dist/docs/TaskCheckbox.js",
      "default": "./dist/docs/TaskCheckbox.js"
    },
    "./tasks/styles.css": {
      "@org/source": "./src/docs/tasks.css",
      "default": "./dist/docs/tasks.css"
    },
    "./streamdown": {
      "@org/source": "./src/streamdown.tsx",
      "source": "./src/streamdown.tsx",
      "types": "./dist/streamdown.d.ts",
      "import": "./dist/streamdown.js",
      "default": "./dist/streamdown.js"
    },
    "./reference": {
      "@org/source": "./src/docs/reference.tsx",
      "source": "./src/docs/reference.tsx",
      "types": "./dist/docs/reference.d.ts",
      "import": "./dist/docs/reference.js",
      "default": "./dist/docs/reference.js"
    },
    "./assets": {
      "@org/source": "./src/assets.ts",
      "source": "./src/assets.ts",
      "types": "./dist/assets.d.ts",
      "import": "./dist/assets.js",
      "default": "./dist/assets.js"
    },
    "./openapi": {
