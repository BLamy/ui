      "default": "./dist/playground/index.js"
    },
    "./source": {
      "@org/source": "./src/source/index.ts",
      "source": "./src/source/index.ts",
      "types": "./dist/source/index.d.ts",
      "import": "./dist/source/index.js",
      "default": "./dist/source/index.js"
    },
    "./demo": {
      "@org/source": "./src/demo/index.ts",
      "source": "./src/demo/index.ts",
      "types": "./dist/demo/index.d.ts",
      "import": "./dist/demo/index.js",
      "default": "./dist/demo/index.js"
    },
    "./vite": {
      "@org/source": "./src/vite/index.ts",
      "source": "./src/vite/index.ts",
      "types": "./dist/vite/index.d.ts",
      "import": "./dist/vite/index.js",
      "default": "./dist/vite/index.js"
    },
    "./site": {
      "@org/source": "./src/site/index.ts",
      "source": "./src/site/index.ts",
      "types": "./dist/site/index.d.ts",
      "import": "./dist/site/index.js",
      "default": "./dist/site/index.js"
    },
    "./site/styles.css": {
      "@org/source": "./src/site/site.css",
      "default": "./dist/site/site.css"
    },
    "./styles.css": {
      "@org/source": "./src/styles.css",
      "default": "./dist/styles.css"
    }
  },
  "dependencies": {
    "@strudel/web": "1.3.0",
    "acorn": "^8.15.0",
    "framer-motion": "^13.1.1",
    "gpu-lexer": "^0.0.2",
    "katex": "^0.18.5",
    "lucide-react": "^1.17.0",
    "pele": "1.6.0",
    "react-aria": "^3.52.1",
    "rrweb": "2.0.0-alpha.20",
    "yaml": "^2.9.0"
  },
  "peerDependencies": {
    "@agent-wasm/core": ">=0.4.0",
    "@brett_lamy/viz-engine": ">=0.2.0",
    "react": ">=18",
    "react-dom": ">=18",
    "vite": ">=5"
  },
  "peerDependenciesMeta": {
    "@agent-wasm/core": {
      "optional": true
    },
    "@brett_lamy/viz-engine": {
      "optional": true
    },
    "vite": {
      "optional": true
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BLamy/ui.git",
    "directory": "packages/docstream"
  },
  "devDependencies": {
    "@agent-wasm/core": "^0.4.0",
    "@brett_lamy/viz-engine": "^0.2.1",
    "@types/node": "^24.0.0",
    "@types/react": "19.0.0",
    "@types/react-dom": "19.0.0",
    "happy-dom": "^20.14.5",
    "vite": "^7.0.0",
    "vitest": "^3.2.4"
  },
  "module": "./dist/index.js",
  "homepage": "https://blamy.github.io/ui/#/docstream",
  "bugs": {
    "url": "https://github.com/BLamy/ui/issues"
  }
}
