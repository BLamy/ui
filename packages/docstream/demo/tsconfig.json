{
  "compilerOptions": {
    "target": "es2022",
    "lib": ["es2022", "dom", "dom.iterable"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "types": ["vite/client"],
    "composite": true,
    "declaration": true,
    "emitDeclarationOnly": true,
    "outDir": "out-tsc",
    "tsBuildInfoFile": "out-tsc/tsconfig.tsbuildinfo",
    "customConditions": ["@org/source"]
  },
  "include": ["src", "../src/env.d.ts"],
  "exclude": ["out-tsc", "dist", "node_modules"],
  "references": []
}
