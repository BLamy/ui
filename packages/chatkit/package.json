{
  "name": "@brett_lamy/chatkit",
  "version": "1.0.0",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@org/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./styles.css": {
      "@org/source": "./src/styles.css",
      "default": "./dist/index.css"
    }
  },
  "dependencies": {
    "@brett_lamy/ui": "workspace:*",
    "@brett_lamy/workbench": "workspace:*",
    "class-variance-authority": "^0.7.1",
    "framer-motion": "^12 || ^13",
    "react-aria-components": "^1.20.0"
  },
  "peerDependencies": {
    "react": "^18 || ^19",
    "react-dom": "^18 || ^19"
  },
  "description": "Composable team-chat scaffold for BL UI",
  "license": "MIT",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "react",
    "blui",
    "ios",
    "react-aria",
    "shadcn",
    "components"
  ]
}
