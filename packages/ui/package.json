{
  "name": "@brett_lamy/ui",
  "version": "4.0.0",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@org/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./styles.css": {
      "@org/source": "./src/styles.css",
      "default": "./dist/index.css"
    },
    "./theme.css": {
      "@org/source": "./src/theme.css",
      "default": "./dist/theme.css"
    }
  },
  "dependencies": {
    "@brett_lamy/docstream": "1.7.0",
    "@brett_lamy/docstream-editor": "1.7.0",
    "@tiptap/core": "3.30.5",
    "@tiptap/extension-code-block": "3.30.5",
    "@tiptap/extension-list": "3.30.5",
    "@tiptap/extension-placeholder": "3.30.5",
    "@tiptap/extension-table": "3.30.5",
    "@tiptap/pm": "3.30.5",
    "@tiptap/react": "3.30.5",
    "@tiptap/starter-kit": "3.30.5",
    "@tiptap/suggestion": "3.30.5",
    "class-variance-authority": "^0.7",
    "clsx": "^2",
    "framer-motion": "^12 || ^13",
    "gpu-lexer": "0.0.3",
    "perfect-freehand": "^1.2.2",
    "react-aria": "^3.51.0",
    "react-aria-components": "^1",
    "rrweb": "2.0.0-alpha.20",
    "tailwind-merge": "^3"
  },
  "peerDependencies": {
    "react": "^18 || ^19",
    "react-dom": "^18 || ^19"
  },
  "description": "iOS-flavored React components on react-aria-components, Tailwind v4 and cva — containers, lists, tokens, Composer, PencilKit. Also a shadcn registry (source-copy items and app blocks).",
  "license": "MIT",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "react",
    "blui",
    "ios",
    "react-aria",
    "shadcn",
    "components"
  ]
}
