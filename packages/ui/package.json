{
  "name": "@brett_lamy/ui",
  "version": "1.0.0",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@org/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./styles.css": {
      "@org/source": "./src/styles.css",
      "default": "./dist/index.css"
    }
  },
  "dependencies": {
    "@brett_lamy/docstream": "1.0.0",
    "@brett_lamy/docstream-editor": "1.0.1",
    "@pierre/diffs": "^1.3.6",
    "@pierre/trees": "1.0.0-beta.6",
    "@tiptap/core": "3.30.5",
    "@tiptap/extension-code-block": "3.30.5",
    "@tiptap/extension-code-block-lowlight": "3.30.5",
    "@tiptap/extension-list": "3.30.5",
    "@tiptap/extension-placeholder": "3.30.5",
    "@tiptap/extension-table": "3.30.5",
    "@tiptap/pm": "3.30.5",
    "@tiptap/react": "3.30.5",
    "@tiptap/starter-kit": "3.30.5",
    "@tiptap/suggestion": "3.30.5",
    "class-variance-authority": "^0.7",
    "clsx": "^2",
    "framer-motion": "^12 || ^13",
    "ios-vibrator-pro-max": "3.0.3",
    "react-aria": "^3.51.0",
    "react-aria-components": "^1",
    "tailwind-merge": "^3"
  },
  "peerDependencies": {
    "react": "^18 || ^19",
    "react-dom": "^18 || ^19"
  },
  "description": "iOS-flavored React components — containers, lists, haptics, tokens, plus the workbench (composer, chat, terminal, surfaces) and team-chat shells (react-aria base, shadcn conventions)",
  "license": "MIT",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "react",
    "blui",
    "ios",
    "react-aria",
    "shadcn",
    "components"
  ]
}
