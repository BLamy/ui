{
  "name": "@brett_lamy/ui",
  "version": "1.0.0",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@org/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./styles.css": {
      "@org/source": "./src/styles.css",
      "default": "./dist/index.css"
    }
  },
  "dependencies": {
    "class-variance-authority": "^0.7",
    "clsx": "^2",
    "framer-motion": "^12 || ^13",
    "ios-vibrator-pro-max": "3.0.3",
    "react-aria": "^3.51.0",
    "react-aria-components": "^1",
    "tailwind-merge": "^3"
  },
  "peerDependencies": {
    "react": "^18 || ^19",
    "react-dom": "^18 || ^19"
  },
  "description": "iOS-flavored React core — containers, lists, haptics, tokens (react-aria base, shadcn conventions)",
  "license": "MIT",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "react",
    "blui",
    "ios",
    "react-aria",
    "shadcn",
    "components"
  ]
