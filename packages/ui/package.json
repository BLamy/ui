{
  "name": "@brett_lamy/ui",
  "version": "6.0.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BLamy/ui.git",
    "directory": "packages/ui"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@org/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./styles.css": {
      "@org/source": "./src/styles.css",
      "default": "./dist/index.css"
    },
    "./theme.css": {
      "@org/source": "./src/theme.css",
      "default": "./dist/theme.css"
    },
    "./tui": {
      "@org/source": "./src/components/tui-preview.tsx",
      "types": "./dist/components/tui-preview.d.ts",
      "import": "./dist/components/tui-preview.js",
      "default": "./dist/components/tui-preview.js"
    },
    "./opencode": {
      "@org/source": "./src/opencode.ts",
      "types": "./dist/opencode.d.ts",
      "import": "./dist/opencode.js",
      "default": "./dist/opencode.js"
    },
    "./tailscale-sw.js": {
      "@org/source": "./src/lib/tailscale-router/tailscale-sw.js",
      "default": "./dist/tailscale-sw.js"
    },
    "./ffmpeg-worker.js": {
      "@org/source": "./src/lib/ffmpeg/ffmpeg-worker.js",
      "default": "./dist/ffmpeg-worker.js"
    }
  },
  "dependencies": {
    "@brett_lamy/docstream": "2.0.0",
    "@brett_lamy/docstream-editor": "2.0.0",
    "@tiptap/core": "3.30.5",
    "@tiptap/extension-code": "3.30.5",
    "@tiptap/extension-code-block": "3.30.5",
    "@tiptap/extension-list": "3.30.5",
    "@tiptap/extension-placeholder": "3.30.5",
    "@tiptap/extension-table": "3.30.5",
    "@tiptap/pm": "3.30.5",
    "@tiptap/react": "3.30.5",
    "@tiptap/starter-kit": "3.30.5",
    "@ui-sdk/core": "workspace:@brett_lamy/ui-sdk-core@*",
    "@ui-sdk/react": "workspace:@brett_lamy/ui-sdk-react@*",
    "@vscode/codicons": "0.0.46-24",
    "@wterm/dom": "0.5.8",
    "@wterm/ghostty": "0.5.8",
    "@wterm/react": "0.5.8",
    "class-variance-authority": "^0.7",
    "clsx": "^2",
    "cronstrue": "^3.27.0",
    "framer-motion": "^12 || ^13",
    "gpu-cron": "0.1.1",
    "gpu-lexer": "0.0.3",
    "gpu-time": "0.5.0",
    "perfect-freehand": "^1.2.2",
    "rrweb": "2.0.0-alpha.20",
    "tailwind-merge": "^3"
  },
  "peerDependencies": {
    "@agent-wasm/tailscale-connect": "^1.39.98-t02582083d",
    "@electric-sql/pglite": "^0.5.8",
    "@electric-sql/pglite-tools": "^0.4.8",
    "react": "^19",
    "react-dom": "^19"
  },
  "peerDependenciesMeta": {
    "@agent-wasm/tailscale-connect": {
      "optional": true
    },
    "@electric-sql/pglite": {
      "optional": true
    },
    "@electric-sql/pglite-tools": {
      "optional": true
    }
  },
  "description": "iOS-flavored React components on UI SDK, Tailwind v4 and cva: adaptive containers (SplitView, NavigationStack, Credenza), lists, tokens, Composer, PencilKit. Also a shadcn registry (source-copy items and app blocks).",
  "license": "MIT",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "prepublishOnly": "cd ../.. && pnpm nx run-many -t build -p @brett_lamy/ui"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "react",
    "blui",
    "ios",
    "ui-sdk",
    "shadcn",
    "components"
  ],
  "devDependencies": {
    "@agent-wasm/tailscale-connect": "1.39.98-t02582083d",
    "@electric-sql/pglite": "0.5.8",
    "@electric-sql/pglite-tools": "0.4.8",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "fake-indexeddb": "^6.2.5",
    "happy-dom": "^20.14.5",
    "react": "19.2.3",
    "react-dom": "19.2.3"
  }
}
