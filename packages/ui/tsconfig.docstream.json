{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "allowSyntheticDefaultImports": true,
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "rootDir": "src/docstream",
    "outDir": "out-tsc/docstream",
    "tsBuildInfoFile": "out-tsc/docstream/tsconfig.tsbuildinfo",
    "customConditions": ["@org/source"]
  },
  "include": ["src/docstream"],
  "exclude": ["out-tsc", "dist"]
}
