/// <reference types='vitest' />
import { defineConfig } from 'vite';
import react from '@vitejs/plugin-react';
import tailwindcss from '@tailwindcss/vite';
import dts from 'vite-plugin-dts';
import * as path from 'path';
import { copyFileSync } from 'fs';
import { execFileSync } from 'child_process';
import pkg from './package.json' with { type: 'json' };
import { aliases } from '../../tools/alias.mjs';

const entry = Object.fromEntries(
  Object.values(pkg.exports)
    .map((target) => (typeof target === 'object' ? (target as Record<string, string>)['@org/source'] : undefined))
    // docstream's and the editor's entries are built apart, a module per file (scripts/build-docstream.mjs).
    .filter((source): source is string => !!source && /\.tsx?$/.test(source) && !/^\.\/src\/docstream(-editor)?\//.test(source))
    .map((source) => [source.replace(/^\.\/src\//, '').replace(/\.tsx?$/, ''), source.slice(2)]),
);

export default defineConfig(() => ({
  root: import.meta.dirname,
  cacheDir: '../../node_modules/.vite/packages/ui',
  resolve: { alias: aliases },
  plugins: [
    react(),
    tailwindcss(),
    dts({
      entryRoot: 'src',
      // docstream's and the editor's declarations are written here too, as the library's modules import them; their own
      // per-file build (scripts/build-docstream.mjs) then writes them again beside their modules.
      exclude: ['**/*.stories.tsx', 'src/stories/**'],
      tsconfigPath: path.join(import.meta.dirname, 'tsconfig.lib.json'),
    }),
    // The bl-theme ships as plain CSS (`@brett_lamy/ui/theme.css`), copied as is.
    { name: 'bl-theme-css', closeBundle: () => copyFileSync(path.join(import.meta.dirname, 'src/theme.css'), path.join(import.meta.dirname, 'dist/theme.css')) },
    // The Tailscale router's service worker ships as a plain script (`@brett_lamy/ui/tailscale-sw.js`) to copy into public/.
    {
      name: 'bl-tailscale-sw',
      closeBundle: () =>
        copyFileSync(path.join(import.meta.dirname, 'src/lib/tailscale-router/tailscale-sw.js'), path.join(import.meta.dirname, 'dist/tailscale-sw.js')),
    },
    // So does the FFmpeg worker (`@brett_lamy/ui/ffmpeg-worker.js`), to serve next to the FFmpeg wasm build.
    {
      name: 'bl-ffmpeg-worker',
      closeBundle: () =>
        copyFileSync(path.join(import.meta.dirname, 'src/lib/ffmpeg/ffmpeg-worker.js'), path.join(import.meta.dirname, 'dist/ffmpeg-worker.js')),
    },
    // docstream and docstream-editor are compiled as they were as packages of their own, a module per file with tsc, into
    // dist/docstream and dist/docstream-editor (scripts/build-docstream.mjs). The library's own modules import them by the
    // package's name, so they stay external here. Last, after the library's own output is written.
    {
      name: 'bl-docstream',
      closeBundle: {
        sequential: true,
        order: 'post' as const,
        handler: () => execFileSync(process.execPath, [path.join(import.meta.dirname, 'scripts/build-docstream.mjs')], { stdio: 'inherit' }),
      },
    },
    // UI SDK ships inside the package: the compiled fork is copied into dist/vendor/ui-sdk and every `@ui-sdk/…` import
    // in dist (the library's, docstream's, the fork's own) is pointed at it (scripts/vendor-ui-sdk.mjs). After docstream,
    // whose output imports it too.
    {
      name: 'bl-ui-sdk',
      closeBundle: {
        sequential: true,
        order: 'post' as const,
        handler: () => execFileSync(process.execPath, [path.join(import.meta.dirname, 'scripts/vendor-ui-sdk.mjs')], { stdio: 'inherit' }),
      },
    },
  ],
  // Uncomment this if you are using workers.
  // worker: {
  //  plugins: [],
  // },
  // Configuration for building your library.
  // See: https://vite.dev/guide/build.html#library-mode
  build: {
    outDir: './dist',
    emptyOutDir: true,
    reportCompressedSize: true,
    commonjsOptions: {
      transformMixedEsModules: true,
    },
    lib: {
      // Every code entry point in package.json `exports`: the root barrel, ./opencode, one per library
      // (`@brett_lamy/ui/audio`), one per module (`@brett_lamy/ui/dialog`, `@brett_lamy/ui/lib/theme`…) and one per UI
      // SDK entry (`@brett_lamy/ui/sdk/react/dialog`), all generated by tools/registry/build.mjs. As entries, each
      // module keeps all of its exports in dist, not only what the barrel re-exports.
      entry,
      name: '@brett_lamy/ui',
      fileName: 'index',
      // Change this to the formats you want to support.
      // Don't forget to update your package.json as well.
      formats: ['es' as const],
    },
    rolldownOptions: {
      // One output module per source module: bundlers drop what an app doesn't import, and the module-level
      // 'use client' directives survive per file. (The stylesheet is still a single dist/index.css.)
      output: { preserveModules: true, preserveModulesRoot: 'src', entryFileNames: '[name].js' },
      // External packages that should not be bundled into your library.
      // Dependencies stay external so apps share one copy, and so do the library's docstream entries, which its modules
      // import by the package's name and which are built apart. UI SDK stays external here too, though it is no
      // dependency of the published package: the `bl-ui-sdk` step copies it in as modules of its own and points these
      // imports at them, so every entry shares one copy of its layer stack and focus state.
      external: (id: string) =>
        /^@brett_lamy\/ui\/(docstream(-editor)?(\/|$)|cloudflare$)/.test(id) ||
        [...Object.keys(pkg.dependencies ?? {}), ...Object.keys(pkg.peerDependencies ?? {}), '@ui-sdk/core', '@ui-sdk/react', 'react/jsx-runtime']
          .some((dep) => id === dep || id.startsWith(dep + '/')),
    },
  },
}));
