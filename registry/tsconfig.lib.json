{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "tsBuildInfoFile": "dist/tsconfig.lib.tsbuildinfo",
    "lib": ["es2022", "dom", "dom.iterable"],
    "jsx": "react-jsx",
    "types": ["node", "vite/client"],
    "rootDir": "."
  },
  "include": ["blocks/**/*.ts", "blocks/**/*.tsx", "components/**/*.ts", "components/**/*.tsx"],
  "exclude": ["dist"],
  "references": [
    { "path": "../packages/pencilkit/tsconfig.lib.json" },
    { "path": "../packages/ui/tsconfig.lib.json" }
  ]
}
