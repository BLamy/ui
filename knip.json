{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "ignoreExportsUsedInFile": true,
  "rules": {
    "duplicates": "off"
  },
  // Build-output wrappers that tools/ui-sdk/build.mjs generates around the UI SDK fork (vendor/ui-sdk): no source here.
  "ignoreWorkspaces": ["packages/ui-sdk-core", "packages/ui-sdk-react"],
  "workspaces": {
    ".": {
      "entry": [
        "tools/**/*.{mjs,mts}"
      ],
      "project": [
        "tools/**/*.{mjs,mts,ts}"
      ],
      "ignoreDependencies": [
        "clsx",
        "tailwind-merge",
        "perfect-freehand",
        "buffer",
        "shadcn",
        "@nx/devkit",
        "@nx/workspace",
        "@nx/web",
        "@swc/helpers",
        "ts-node",
        "@eslint/js",
        "typescript-eslint",
        "jsonc-eslint-parser",
        "eslint-plugin-import",
        "eslint-plugin-jsx-a11y",
        "eslint-plugin-playwright",
        "eslint-plugin-react",
        "eslint-plugin-react-hooks",
        "happy-dom",
        "@electron/packager",
        // Imported as `@ui-sdk/*` through `workspace:@brett_lamy/ui-sdk-*@*` aliases. Knip resolves those imports to the
        // workspace's files and matches them by its package name, so it never counts the alias as used.
        "@ui-sdk/core",
        "@ui-sdk/react",
        // Used from CSS only (`@import "tailwindcss/utilities.css"` in packages/ui/src/styles.css), which knip does not read.
        "tailwindcss"
      ],
      // The root vitest config only lists the packages' own configs, and the root has no stories (apps/catalog does).
      // Without this, the plugins' default globs pick up vendor/ui-sdk (a git submodule with its own toolchain).
      "vitest": {
        "config": ["vitest.config.mts"],
        "entry": []
      },
      "storybook": false
    },
    "packages/ui": {
      "entry": [
        "src/**/*.stories.tsx",
        "src/**/*.test.{ts,tsx}"
      ],
      "project": [
        "src/**/*.{ts,tsx}"
      ],
      // Imported from CSS only (`@import "@vscode/codicons/dist/codicon.css"` in src/styles.css).
      "ignoreDependencies": ["@vscode/codicons"]
    },
    "registry": {
      "entry": [
        "blocks/*/page.tsx",
        "blocks/**/*.stories.tsx",
        // The package's own exports (`./blocks/types`, `./components/types`): the shapes meta.json and manifests follow.
        "blocks/types.ts",
        "components/types.ts"
      ],
      "project": [
        "**/*.{ts,tsx}"
      ],
      "ignoreDependencies": [
        "@brett_lamy/ui"
      ]
    },
    "apps/docs": {
      "entry": [
        "src/page-export.ts",
        "examples/*/*/index.tsx"
      ],
      "project": [
        "src/**/*.{ts,tsx}",
        "examples/**/*.{ts,tsx}"
      ],
      "ignoreDependencies": [
        "@brett_lamy/docstream-editor",
        "@tiptap/.+",
        "highlight.js",
        "lowlight"
      ]
    },
    "apps/catalog": {
      "entry": [
        "stories/**/*.stories.tsx",
        ".storybook/*.{ts,tsx}"
      ],
      "project": [
        "stories/**/*.{ts,tsx}"
      ],
      "ignoreDependencies": [
        "highlight.js",
        "use-sync-external-store",
        "@brett_lamy/ui"
      ]
    }
  }
}
