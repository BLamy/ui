{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "ignoreExportsUsedInFile": true,
  "rules": {
    "duplicates": "off"
  },
  // Build output that tools/ui-sdk/build.mjs compiles from the UI SDK fork (vendor/ui-sdk): private, no source here.
  "ignoreWorkspaces": ["packages/ui-sdk-core", "packages/ui-sdk-react"],
  "workspaces": {
    ".": {
      "entry": [
        "tools/**/*.{mjs,mts}"
      ],
      "project": [
        "tools/**/*.{mjs,mts,ts}"
      ],
      "ignoreDependencies": [
        "clsx",
        "tailwind-merge",
        "perfect-freehand",
        "buffer",
        "shadcn",
        "@nx/devkit",
        "@nx/workspace",
        "@nx/web",
        "@swc/helpers",
        "ts-node",
        "@eslint/js",
        "typescript-eslint",
        "jsonc-eslint-parser",
        "eslint-plugin-import",
        "eslint-plugin-jsx-a11y",
        "eslint-plugin-playwright",
        "eslint-plugin-react",
        "eslint-plugin-react-hooks",
        "happy-dom",
        "@electron/packager",
        // The UI SDK fork's two build outputs, at the root so the fork's own declaration build (run inside vendor/ui-sdk
        // by tools/ui-sdk/build.mjs) finds `@ui-sdk/core` from its React package. No source of ours imports them from
        // here: the library does (packages/ui), and everything else goes through `@brett_lamy/ui/sdk/…`.
        "@ui-sdk/core",
        "@ui-sdk/react"
      ],
      // The root vitest config only lists the packages' own configs, and the root has no stories (apps/catalog does).
      // Without this, the plugins' default globs pick up vendor/ui-sdk (a git submodule with its own toolchain).
      "vitest": {
        "config": ["vitest.config.mts"],
        "entry": []
      },
      "storybook": false
    },
    "packages/ui": {
      "entry": [
        // The generated entries (tools/registry/build.mjs): one per library (`@brett_lamy/ui/audio`) and one per UI SDK
        // entry (`@brett_lamy/ui/sdk/react/dialog`), each a file of re-exports.
        "src/libraries/*.ts",
        "src/sdk/**/*.ts",
        // Docstream's public entries (package.json `exports`), named here so a run does not depend on how a given
        // install resolves `@brett_lamy/ui/docstream/<entry>`. Knip calls some of these (and the registry's two
        // `types.ts` entries) redundant in a long-lived checkout; a fresh clone, which is what CI runs, needs them.
        "src/docstream/index.ts",
        "src/docstream/*/index.ts",
        "src/docstream/replay/demo/index.ts",
        "src/docstream/strudel/{rack.ts,ast/index.ts}",
        "src/docstream/xstate/machine.ts",
        "src/docstream/{streamdown.tsx,assets.ts}",
        "src/docstream/docs/{DocumentProperties,TaskCheckbox,reference}.tsx",
        "src/docstream/openapi/OpenApiOperation.tsx",
        "src/docstream-editor/index.ts",
        "src/docstream-editor/editor/{Editor.tsx,convert.ts}",
        "src/**/*.stories.tsx",
        "src/**/*.test.{ts,tsx}"
      ],
      "project": [
        "src/**/*.{ts,tsx}"
      ],
      "ignoreDependencies": [
        // Imported as `@ui-sdk/*` through `workspace:@brett_lamy/ui-sdk-*@*` aliases (dev dependencies: the build copies
        // them into dist). Knip resolves those imports to the workspace's files and matches them by its package name,
        // so it never counts the alias as used.
        "@ui-sdk/core",
        "@ui-sdk/react"
      ]
    },
    "registry": {
      "entry": [
        "blocks/*/page.tsx",
        "blocks/**/*.stories.tsx",
        // The shapes of meta.json and the component manifests: documentation for the JSON files, imported by nothing.
        "blocks/types.ts",
        "components/types.ts"
      ],
      "project": [
        "**/*.{ts,tsx}"
      ]
    },
    "apps/docs": {
      "entry": [
        "src/page-export.ts",
        "examples/*/*/index.tsx",
        // The BL site's `virtual:bl-site-files` module (vite.config.mts): an ambient declaration nothing imports.
        "src/site/virtual.d.ts"
      ],
      "project": [
        "src/**/*.{ts,tsx}",
        "examples/**/*.{ts,tsx}",
        // The Tailwind sheet main.tsx imports: its `@import "@brett_lamy/registry/styles.css"` is the app's use of the registry.
        "src/site/site.css"
      ],
      "ignoreDependencies": [
        "@tiptap/.+",
        "highlight.js",
        "lowlight"
      ]
    },
    "apps/docstream-playground": {
      // Run from package.json scripts (`node scripts/copy-sw.mjs && vite build && node scripts/prune-dist.mjs`).
      "entry": ["scripts/*.mjs"]
    },
    "apps/catalog": {
      "entry": [
        "stories/**/*.stories.tsx",
        ".storybook/*.{ts,tsx}"
      ],
      "project": [
        "stories/**/*.{ts,tsx}"
      ],
      "ignoreDependencies": [
        "highlight.js",
        "use-sync-external-store"
      ]
    }
  }
}
