{
  "name": "@brett_lamy/docstream-editor",
  "version": "0.3.3",
  "description": "TipTap editor for Docstream GitBook-style markdown documents.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "files": [
    "src",
    "README.md"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./styles.css": "./src/styles.css"
  },
  "dependencies": {
    "@brett_lamy/docstream": "0.3.2",
    "lowlight": "^3.3.0",
    "lucide-react": "^1.17.0"
  },
