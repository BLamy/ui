{
  "name": "@brett_lamy/docstream-editor",
  "version": "0.5.5",
  "description": "TipTap editor for Docstream GitBook-style markdown documents.",
  "type": "module",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "files": [
    "src",
    "!src/**/*.test.ts",
    "README.md"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./editor": {
      "types": "./src/editor/Editor.tsx",
      "import": "./src/editor/Editor.tsx"
    },
    "./convert": {
      "types": "./src/editor/convert.ts",
      "import": "./src/editor/convert.ts"
    },
    "./styles.css": "./src/styles.css"
  },
  "dependencies": {
    "@brett_lamy/docstream": "^0.5.5",
    "lowlight": "^3.3.0",
    "lucide-react": "^1.17.0"
  },
  "peerDependencies": {
    "@tiptap/core": "^3.26.1",
    "@tiptap/extension-code-block-lowlight": "^3.26.1",
    "@tiptap/extension-list": "^3.26.1",
    "@tiptap/extension-placeholder": "^3.26.1",
    "@tiptap/extension-table": "^3.26.1",
    "@tiptap/pm": "^3.26.1",
    "@tiptap/react": "^3.26.1",
    "@tiptap/starter-kit": "^3.26.1",
    "@tiptap/suggestion": "^3.26.1",
    "react": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BLamy/docstream-editor.git"
  },
  "devDependencies": {
    "@agent-wasm/core": "^0.4.0",
    "@tiptap/core": "^3.26.1",
    "@tiptap/extension-code-block-lowlight": "^3.26.1",
    "@tiptap/extension-list": "^3.26.1",
    "@tiptap/extension-placeholder": "^3.26.1",
    "@tiptap/extension-table": "^3.26.1",
    "@tiptap/pm": "^3.26.1",
    "@tiptap/react": "^3.26.1",
    "@tiptap/starter-kit": "^3.26.1",
    "@tiptap/suggestion": "^3.26.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "react": "^19",
    "react-dom": "^19",
    "typescript": "^5.6.0",
    "vitest": "^3.2.4"
  }
}
