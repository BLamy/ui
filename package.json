{
  "name": "@brett_lamy/docstream",
  "version": "0.3.5",
  "description": "GitBook-aware readonly markdown and AI stream renderer.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "files": [
    "src",
    "README.md"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./gitbook": {
      "types": "./src/gitbook/index.ts",
      "import": "./src/gitbook/index.ts"
    },
    "./streamdown": {
      "types": "./src/streamdown.tsx",
      "import": "./src/streamdown.tsx"
    },
    "./assets": {
      "types": "./src/assets.ts",
      "import": "./src/assets.ts"
    },
    "./openapi": {
      "types": "./src/openapi/OpenApiOperation.tsx",
      "import": "./src/openapi/OpenApiOperation.tsx"
    },
    "./replay": {
      "types": "./src/replay/index.ts",
      "import": "./src/replay/index.ts"
    },
    "./video": {
      "types": "./src/video/index.ts",
      "import": "./src/video/index.ts"
    },
    "./viz": {
      "types": "./src/viz/index.ts",
      "import": "./src/viz/index.ts"
    },
    "./playground": {
      "types": "./src/playground/index.ts",
      "import": "./src/playground/index.ts"
    },
    "./styles.css": "./src/styles.css"
  },
  "dependencies": {
    "hast-util-to-html": "^9.0.5",
    "lowlight": "^3.3.0",
    "lucide-react": "^1.17.0",
    "mermaid": "^11.15.0",
    "rrweb": "2.0.0-alpha.20",
    "streamdown": "^2.5.0",
    "yaml": "^2.9.0",
    "@brett_lamy/viz-engine": "^0.2.0"
  },
  "peerDependencies": {
    "@agent-wasm/core": ">=0.4.0",
    "@brett_lamy/viz-engine": ">=0.2.0",
    "react": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BLamy/docstream.git"
  },
  "devDependencies": {
    "@agent-wasm/core": "^0.4.0",
    "@types/react": "^18.3.3",
    "typescript": "^5.5.4"
  }
}
