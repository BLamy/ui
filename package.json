{
  "name": "@brett_lamy/docstream",
  "version": "0.6.4",
  "description": "GitBook-aware readonly markdown and AI stream renderer.",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "files": [
    "src",
    "!src/**/*.test.ts",
    "README.md"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./gitbook": {
      "types": "./src/gitbook/index.ts",
      "import": "./src/gitbook/index.ts"
    },
    "./streamdown": {
      "types": "./src/streamdown.tsx",
      "import": "./src/streamdown.tsx"
    },
    "./reference": {
      "types": "./src/docs/reference.tsx",
      "import": "./src/docs/reference.tsx"
    },
    "./assets": {
      "types": "./src/assets.ts",
      "import": "./src/assets.ts"
    },
    "./openapi": {
      "types": "./src/openapi/OpenApiOperation.tsx",
      "import": "./src/openapi/OpenApiOperation.tsx"
    },
    "./replay": {
      "types": "./src/replay/index.ts",
      "import": "./src/replay/index.ts"
    },
    "./video": {
      "types": "./src/video/index.ts",
      "import": "./src/video/index.ts"
    },
    "./viz": {
      "types": "./src/viz/index.ts",
      "import": "./src/viz/index.ts"
    },
    "./playground": {
      "types": "./src/playground/index.ts",
      "import": "./src/playground/index.ts"
    },
    "./source": {
      "types": "./src/source/index.ts",
      "import": "./src/source/index.ts"
    },
    "./vite": {
      "types": "./src/vite/index.ts",
      "import": "./src/vite/index.ts"
    },
    "./styles.css": "./src/styles.css"
  },
  "dependencies": {
    "@brett_lamy/viz-engine": ">=0.2.0",
    "framer-motion": "^13.1.1",
    "katex": "^0.18.5",
    "gpu-lexer": "^0.0.2",
    "lucide-react": "^1.17.0",
    "mermaid": "^11.15.0",
    "rrweb": "2.0.0-alpha.20",
    "streamdown": "^2.5.0",
    "yaml": "^2.9.0"
  },
  "peerDependencies": {
    "@agent-wasm/core": ">=0.4.0",
    "@brett_lamy/viz-engine": ">=0.2.0",
    "react": ">=18",
    "vite": ">=5"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BLamy/docstream.git"
  },
  "devDependencies": {
    "@agent-wasm/core": "^0.4.0",
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.3",
    "typescript": "^5.5.4",
    "vite": "^7.0.0",
    "vitest": "^3.2.4"
  }
}
