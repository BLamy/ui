    "@ui-sdk/react": "workspace:@brett_lamy/ui-sdk-react@*",
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "devDependencies": {
    "vite-plugin-node-polyfills": "^0.28.0"
  }
}
