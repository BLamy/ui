{
  "compilerOptions": {
    "target": "es2022",
    "lib": ["es2022", "dom", "dom.iterable"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["vite/client", "node", "@tiptap/starter-kit"],
    "customConditions": ["@org/source"]
  },
  "include": [
    "src",
    "docs.test.ts",
    "../../packages/ui/src/docstream/env.d.ts"
  ],
  "references": [
    {
      "path": "../../packages/ui"
    }
  ]
}
