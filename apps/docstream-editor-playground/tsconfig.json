{
  "compilerOptions": {
    "target": "es2022",
    "lib": ["es2022", "dom", "dom.iterable"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["vite/client", "node", "@tiptap/starter-kit"],
    "paths": {
      "@brett_lamy/ui/docstream-editor": [
        "../../packages/ui/src/docstream-editor/index.ts"
      ]
    }
  },
  "include": ["src"],
  "references": [
    {
      "path": "../../packages/ui"
    }
  ]
}
